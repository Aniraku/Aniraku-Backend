[Unit]
Description=mkissa egress forwarder (local http -> free socks4 upstream)
After=network-online.target
Wants=network-online.target

[Service]
# Binds ONLY to the docker bridge address: the hop is reachable by the
# api container (MKISSA_PROXY=http://172.18.0.1:18080) and localhost,
# never from the internet. pproxy speaks plain HTTP CONNECT locally and
# socks4 upstream — bun's env proxy only understands http://, while the
# upstream itself only speaks socks4.
# pproxy on Python >= 3.14 needs the asyncio patch from README.md
# re-applied after every pip upgrade of the package.
ExecStart=/usr/local/bin/pproxy -l http://172.18.0.1:18080 -r socks4://183.106.215.208:1080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
