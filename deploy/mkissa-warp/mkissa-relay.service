[Unit]
Description=mkissa local TLS splice (runs inside the mkissawg namespace)
After=mkissa-warp-ns.service
Requires=mkissa-warp-ns.service

[Service]
ExecStart=/usr/bin/ip netns exec mkissawg /usr/bin/python3 /usr/local/bin/mkissa-relay.py
Restart=always
RestartSec=3
# storage friendly: journal is capped by journald, no log files on disk
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
