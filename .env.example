# Aniraku Backend - Example Environment
# Copy this file to .env and fill in your own values.
# DO NOT commit real secrets to public repos - keep .env private.
# This example uses placeholder/fake values to avoid DMCA/leaks.

# Supabase - replace with your own project
ANIRAKU_SUPABASE_URL=https://your-project.supabase.co
ANIRAKU_SUPABASE_ANON_KEY=your-anon-key-here
ANIRAKU_SUPABASE_SERVICE_KEY=your-service-role-key-here
ANIRAKU_SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Server
ANIRAKU_SERVER_HOST=127.0.0.1
ANIRAKU_SERVER_PORT=43211
ANIRAKU_SERVER_DEBUG=false
ANIRAKU_MIRURO_PROXY_URL=
ANIRAKU_ANIKOTO_MAPPING_PATH=

# TMDB - Episode metadata fallback (AniZip ↔ TMDB bidirectional)
# Get your own token at https://www.themoviedb.org/settings/api
# Use v4 Read Access Token (starts with eyJ...), never share real token publicly
TMDB_READ_ACCESS_TOKEN=YOUR_TMDB_V4_READ_ACCESS_TOKEN_HERE
ANIRAKU_TMDB_READ_ACCESS_TOKEN=YOUR_TMDB_V4_READ_ACCESS_TOKEN_HERE
ANIRAKU_TMDB_API_BASE=https://api.themoviedb.org/3
ANIRAKU_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/w780
ANIRAKU_ANIBRIDGE_API=https://mappings.anibridge.eliasbenb.dev/api/v3/mappings

# Scraping / Streaming - public bases, no secrets
ANIRAKU_ANIMEX_BASE=https://animex.one
ANIRAKU_FLIXCLOUD_BASE=https://flixcloud.cc
ANIRAKU_ANIZIP_BASE=https://api.ani.zip

# CORS - comma-separated allowed origins
ANIRAKU_CORS_ORIGINS=https://example.com,https://your-frontend.vercel.app

# OAuth sync (optional) - create at https://myanimelist.net/apiconfig and https://anilist.co/api/v2/oauth
ANIRAKU_MAL_CLIENT_ID=your-mal-client-id
ANIRAKU_MAL_CLIENT_SECRET=your-mal-client-secret
ANIRAKU_ANILIST_CLIENT_ID=your-anilist-client-id
ANIRAKU_ANILIST_CLIENT_SECRET=your-anilist-client-secret
ANIRAKU_OAUTH_REDIRECT_URL=https://example.com/sync/callback
ANIRAKU_OAUTH_STATE_SECRET=generate-a-random-32-char-string-here

# Trusted proxies for RealIP (comma-separated CIDRs)
ANIRAKU_TRUSTED_PROXY_CIDRS=

# Media proxy allowlist (comma-separated suffixes/hosts)
ANIRAKU_PROXY_CDN_ALLOWLIST=
